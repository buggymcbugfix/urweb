#!/bin/sh
#
# Golden tests of the toolbox, on a fixture tree with a stand-in compiler.
#
# The tree is built afresh for every case by urt/tests/snapshot/tree.sh
# (projects, their snapshots, and one of every mistake the runner
# notices); the compiler is urt/tests/snapshot/urweb, which says what it
# was asked and writes what it was asked for.  A case is a directory with
#
#   cmd         what to run, as shell lines, from the root of the tree;
#               `urt` on them is the program under test
#   env         optional: VAR=value lines
#   expected    the transcript
#
# in one of two families:
#
#   tests/snapshot/CASE   each line of cmd is run in turn and its output,
#                         stdout and stderr together, and its exit status
#                         go in the transcript.  TUI_KEYS in a line scripts
#                         an interactive command, whose frames are then
#                         printed in full.
#
#   tests/pty/CASE        the one line of cmd runs on a pseudo-terminal
#                         (urt/tests/terminal.py) and is sent the keys in
#                         `keys`; the transcript is the screen after each,
#                         boxed, how it ended, and whether the tty was
#                         restored.
#                         Needs python3; skipped without it.
#
# Either way the transcript ends with what the commands did to the tree:
# every file added, removed or changed.  Times in summaries and the tree's
# path are normalised away.
#
#   urt/check [-u] [PROGRAM]
#
# PROGRAM is urt/urt unless given.  -u rewrites expected.

set -u
me=${0##*/}
here=$(cd "$(dirname "$0")" && pwd -P) || exit 2
fixture=$here/tests/snapshot
update=''
[ "${1-}" != -u ] || { update=1; shift; }
program=${1:-$here/urt}
case $program in
    /*) ;;
    *) program=$(pwd -P)/$program ;;
esac
[ -x "$program" ] || { echo "$me: no program at $program" >&2; exit 2; }

# Resolved, since the program prints real paths and macOS puts temporary
# directories behind a symlink.
tmp=$(mktemp -d) || exit 2
tmp=$(cd "$tmp" && pwd -P) || exit 2
trap 'rm -rf "$tmp"' EXIT INT TERM

# Whatever it is called, the program answers to `urt` on the PATH.
mkdir "$tmp/bin"
ln -s "$program" "$tmp/bin/urt"

# Every file under the tree with its checksum and size, by path.
inventory() {
    (cd "$tmp/tree" && find . -type f -exec cksum {} + | LC_ALL=C sort -k3)
}

# What became of the tree between two inventories.
changes() {
    echo '$ changes'
    awk 'NR == FNR { was[$3] = $1 " " $2; next }
         { now[$3] = $1 " " $2; size[$3] = $2 }
         END {
             for (p in was) if (!(p in now)) print p "\tremoved"
             for (p in now) if (!(p in was)) print p "\tadded (" size[p] " bytes)"
                            else if (now[p] != was[p]) print p "\tchanged (" size[p] " bytes)"
         }' "$1" "$2" | LC_ALL=C sort | awk -F '\t' '{ print $2 ": " $1 }'
}

# The environment a case runs in: the tree, the stand-in compiler, a
# UTF-8 locale so that the frames carry the symbols they would, and a
# TMPDIR with a trailing slash, as macOS sets it.
case_env() {
    cd "$tmp/tree" || exit 2
    PATH=$tmp/bin:$PATH
    URWEB=$fixture/urweb
    LANG=C.UTF-8
    TMPDIR=$tmp/
    export PATH URWEB LANG TMPDIR
    [ ! -f "$1/env" ] || { set -a; . "$1/env"; set +a; }
}

failed=0 n=0

# verdict CASE OUTPUT: update or diff the case's expected against OUTPUT.
verdict() {
    name=${1#"$here/tests/"}
    n=$((n + 1))
    if [ -n "$update" ]; then
        cp "$2" "$1/expected"
        echo "updated $name"
    elif diff -u --label "$name/expected" --label "$name (now)" "$1/expected" "$2"; then
        echo "ok $name"
    else
        echo "FAIL $name"
        failed=1
    fi
}

# normalise: the tree's path, and the times in summaries; in a boxed row
# the time gives way to spaces, so that the box keeps its edge.
normalise() {
    sed -e "s|$tmp/tree|TREE|g" | awk '
        match($0, /, in [0-9]+\.[0-9]s$/) {
            $0 = substr($0, 1, RSTART - 1) ", in T"
        }
        match($0, /, in [0-9]+\.[0-9]s *\|$/) {
            $0 = substr($0, 1, RSTART - 1) ", in T" sprintf("%" (RLENGTH - 7) "s|", "")
        }
        { print }'
}

for d in "$fixture"/*/; do
    d=${d%/}
    [ -f "$d/cmd" ] || continue
    rm -rf "$tmp/tree"
    sh "$fixture/tree.sh" "$tmp/tree" || exit 2
    inventory > "$tmp/before"
    (
        case_env "$d"
        NO_COLOR=1
        export NO_COLOR
        while IFS= read -r line; do
            printf '$ %s\n' "$line"
            (eval "$line") 2>&1
            echo "exit $?"
        done < "$d/cmd"
    ) > "$tmp/out"
    inventory > "$tmp/after"
    changes "$tmp/before" "$tmp/after" >> "$tmp/out"
    normalise < "$tmp/out" > "$tmp/transcript"
    verdict "$d" "$tmp/transcript"
done

if command -v python3 > /dev/null 2>&1; then
    for d in "$here"/tests/pty/*/; do
        d=${d%/}
        [ -f "$d/cmd" ] || continue
        rm -rf "$tmp/tree"
        sh "$fixture/tree.sh" "$tmp/tree" || exit 2
        inventory > "$tmp/before"
        (
            case_env "$d"
            printf '$ %s\n' "$(cat "$d/cmd")"
            python3 "$here/tests/terminal.py" "$(cat "$d/keys")" sh -c "$(cat "$d/cmd")" 2>&1
        ) > "$tmp/out"
        inventory > "$tmp/after"
        changes "$tmp/before" "$tmp/after" >> "$tmp/out"
        normalise < "$tmp/out" > "$tmp/transcript"
        verdict "$d" "$tmp/transcript"
    done
else
    echo "$me: no python3, skipping the pty cases" >&2
fi

[ "$n" -gt 0 ] || { echo "$me: no cases under $here/tests" >&2; exit 2; }
echo "$n cases"
exit $failed
